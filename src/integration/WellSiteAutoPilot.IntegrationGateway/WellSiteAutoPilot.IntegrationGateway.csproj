<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Opt-in: the CygNet provider is compiled in only on a host that has the CygNet libraries (CYGNET_LIBRARY_PATH).
       Without it the Gateway builds exactly as before and has no cygnet provider. -->
  <PropertyGroup Condition="'$(CYGNET_LIBRARY_PATH)' != ''">
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);CYGNET</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(CYGNET_LIBRARY_PATH)' != ''">
    <ProjectReference Include="../WellSiteAutoPilot.Integration.CygNet/WellSiteAutoPilot.Integration.CygNet.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../platform/WellSiteAutoPilot.Telemetry/WellSiteAutoPilot.Telemetry.csproj" />
    <ProjectReference Include="../WellSiteAutoPilot.Integration.Contracts/WellSiteAutoPilot.Integration.Contracts.csproj" />
    <ProjectReference Include="../WellSiteAutoPilot.Integration.ForeSite/WellSiteAutoPilot.Integration.ForeSite.csproj" />
    <ProjectReference Include="../WellSiteAutoPilot.Integration.PetroVisor/WellSiteAutoPilot.Integration.PetroVisor.csproj" />
    <ProjectReference Include="../../messaging/WellSiteAutoPilot.Messaging.Nats/WellSiteAutoPilot.Messaging.Nats.csproj" />
    <ProjectReference Include="../../platform/WellSiteAutoPilot.Http/WellSiteAutoPilot.Http.csproj" />
  </ItemGroup>
</Project>
