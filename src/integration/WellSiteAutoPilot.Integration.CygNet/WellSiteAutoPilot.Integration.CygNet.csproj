<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads CygNet through the CygNet API already installed on the Gateway's server. Nothing from CygNet is referenced at build
       time or shipped: the libraries are found and loaded at run time (see CygNetInstallLocator), so this builds and packages
       like any other project, and a host without CygNet reports that CygNet is not installed. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1416;CA1031;CA1305;CA5392;SYSLIB1054</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <ProjectReference Include="../WellSiteAutoPilot.Integration.Contracts/WellSiteAutoPilot.Integration.Contracts.csproj" />
    <ProjectReference Include="../WellSiteAutoPilot.Integration.CygNet.Adapter/WellSiteAutoPilot.Integration.CygNet.Adapter.csproj" />
    <ProjectReference Include="../../platform/WellSiteAutoPilot.Failures/WellSiteAutoPilot.Failures.csproj" />
  </ItemGroup>
</Project>
