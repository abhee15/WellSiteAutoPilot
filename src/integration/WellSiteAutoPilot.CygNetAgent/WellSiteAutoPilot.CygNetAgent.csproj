<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- CygNet Native Agent. Intentionally NOT part of WellSiteAutoPilot.slnx: it needs the CygNet client
       assemblies, which are never copied into this repository. Build it on a machine where CygNet is installed:
         dotnet build -p:CygNetLibPath="C:\Program Files\CygNet\Bin"
       (ForeSite's own net10 host loads the same assemblies, so no .NET Framework process is required.) -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <CygNetLibPath Condition="'$(CygNetLibPath)' == ''">C:\CygNet\Bin</CygNetLibPath>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);MSB3277;CS8002;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" />
    <Reference Include="CygNet.API.Core"><HintPath>$(CygNetLibPath)\CygNet.API.Core.dll</HintPath></Reference>
    <Reference Include="CygNet.Core"><HintPath>$(CygNetLibPath)\CygNet.Core.dll</HintPath></Reference>
    <Reference Include="CygNet.Data.Core"><HintPath>$(CygNetLibPath)\CygNet.Data.Core.dll</HintPath></Reference>
    <Reference Include="CygNet.Data.Facilities"><HintPath>$(CygNetLibPath)\CygNet.Data.Facilities.dll</HintPath></Reference>
    <Reference Include="CygNet.API.Facilities"><HintPath>$(CygNetLibPath)\CygNet.API.Facilities.dll</HintPath></Reference>
    <Reference Include="CygNet.COMAPI"><HintPath>$(CygNetLibPath)\CygNet.COMAPI.dll</HintPath></Reference>
  </ItemGroup>
</Project>
