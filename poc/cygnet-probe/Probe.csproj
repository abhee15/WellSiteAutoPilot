<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <CygNetLibs>D:\P4\WFT_Services\ForeSiteService\Trunk\Libraries\CygNet\</CygNetLibs>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CygNet.API.Core"><HintPath>$(CygNetLibs)CygNet.API.Core.dll</HintPath></Reference>
    <Reference Include="CygNet.Core"><HintPath>$(CygNetLibs)CygNet.Core.dll</HintPath></Reference>
    <Reference Include="CygNet.COMAPI"><HintPath>$(CygNetLibs)CygNet.COMAPI.dll</HintPath></Reference>
    <Reference Include="CygNet.API.Points"><HintPath>$(CygNetLibs)CygNet.API.Points.dll</HintPath></Reference>
    <Reference Include="CygNet.API.Facilities"><HintPath>$(CygNetLibs)CygNet.API.Facilities.dll</HintPath></Reference>
    <Reference Include="CygNet.Data.Core"><HintPath>$(CygNetLibs)CygNet.Data.Core.dll</HintPath></Reference>
    <Reference Include="CygNet.Data.Points"><HintPath>$(CygNetLibs)CygNet.Data.Points.dll</HintPath></Reference>
    <Reference Include="CygNet.Data.Facilities"><HintPath>$(CygNetLibs)CygNet.Data.Facilities.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(CygNetLibs)**\*.*" Exclude="$(CygNetLibs)**\*.pdb;$(CygNetLibs)**\*.xml" CopyToOutputDirectory="PreserveNewest" LinkBase="." />
  </ItemGroup>
</Project>
