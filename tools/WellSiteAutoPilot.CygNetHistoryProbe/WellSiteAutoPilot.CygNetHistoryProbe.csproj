<Project Sdk="Microsoft.NET.Sdk">
  <!-- Explicit licensed-host tool; uses the CygNet already installed on the machine it runs on. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <!-- The CLI boundary redacts all provider exceptions into stable failure codes. -->
    <NoWarn>$(NoWarn);CA1031</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/integration/WellSiteAutoPilot.Integration.CygNet/WellSiteAutoPilot.Integration.CygNet.csproj" />
  </ItemGroup>
</Project>
