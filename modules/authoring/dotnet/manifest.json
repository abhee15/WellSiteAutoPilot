{
  "manifestVersion": 1,
  "moduleId": "weatherford.foresite-well-input-check.dotnet",
  "version": "1.0.2",
  "displayName": "ForeSite Well Input Check (dotnet)",
  "publisher": "Weatherford",
  "runtime": "DotNet",
  "executionProfile": "ScheduledOneShot",
  "entryPoint": "Weatherford.ForeSiteWellInputCheck.EntryPoint",
  "minimumSdkVersion": "1.1.0",
  "requiredAdapterKey": "foresite",
  "description": "Observe one supplied pump-fillage input in Shadow. No provider writes. Live ForeSite mapping is a separate prerequisite.",
  "assetRequirements": [
    {
      "role": "well",
      "minimumCount": 1,
      "maximumCount": 1,
      "requiredAssetTypeKey": "well",
      "requiredTraits": []
    }
  ],
  "dataRequirements": [
    {
      "id": "pump-fillage",
      "assetRole": "well",
      "quantity": "PumpFillage",
      "access": "Current",
      "canonicalUnit": "%",
      "maximumAgeSeconds": 60,
      "allowUncertainQuality": false
    }
  ],
  "commandRequirements": []
}
